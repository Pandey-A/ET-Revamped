# FastAPI AI runtime
CORE_API_URL=http://127.0.0.1:5001/api
INTERNAL_API_KEY=must-match-server-INTERNAL_API_KEY

# Meta WhatsApp webhook (set same verify token in Meta Developer Console)
WHATSAPP_VERIFY_TOKEN=your-verify-token-here
WHATSAPP_APP_SECRET=your-meta-app-secret

# Public HTTPS base for webhook + media (ngrok URL during local dev, no trailing slash)
PUBLIC_BASE_URL=https://your-subdomain.ngrok-free.app

# Vector DB — local: docker compose up -d weaviate (default http://localhost:8080)
# Production: WEAVIATE_URL=http://your-ec2-ip:8080
WEAVIATE_URL=http://localhost:8080
WEAVIATE_GRPC_PORT=50051

# Optional: improves RAG answer quality via reranking (works without this too)
# COHERE_API_KEY=
