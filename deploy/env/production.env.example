# =============================================================================
# Production — elevatetrust.in (copy to /opt/deepfake_et_frontend/.env on EC2)
# cp deploy/env/production.env.example /opt/deepfake_et_frontend/.env && nano /opt/deepfake_et_frontend/.env
# =============================================================================

# --- Public site (DNS A record → EC2) ---
APP_DOMAIN=elevatetrust.in
APP_PUBLIC_URL=https://elevatetrust.in
TELEGRAM_WEBHOOK_BASE_URL=https://elevatetrust.in
COOKIE_SECURE=true

# --- PostgreSQL (docker-compose.infra.yml) ---
POSTGRES_USER=chattiq
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=chattiq
DATABASE_URL=postgresql://chattiq:CHANGE_ME_STRONG_PASSWORD@127.0.0.1:5432/chattiq

REDIS_URL=redis://127.0.0.1:6379

# --- Express (nginx: https://elevatetrust.in/api/) ---
PORT=8002
NODE_ENV=production
JWT_SECRET=CHANGE_ME_JWT_SECRET_MIN_32_CHARS
EMAIL_VERIFY_SECRET=CHANGE_ME_EMAIL_VERIFY_SECRET
FRONTEND_URL=https://elevatetrust.in
CORS_ORIGINS=https://elevatetrust.in,https://www.elevatetrust.in
CORS_EXTRA_ORIGINS=
FASTAPI_AGENT_SYNC_URL=http://127.0.0.1:8000
AI_AGENT_API_URL=http://127.0.0.1:8000

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM=noreply@elevatetrust.in

# --- Next.js (rebuild after changing any NEXT_PUBLIC_*) ---
NEXT_PUBLIC_API_URL=https://elevatetrust.in/api
NEXT_PUBLIC_AI_AGENT_API_URL=https://elevatetrust.in/api/agent
NEXT_PUBLIC_APP_ORIGIN=https://elevatetrust.in
NEXT_PUBLIC_WIDGET_CHAT_API_URL=https://elevatetrust.in
AI_AGENT_API_URL=http://127.0.0.1:8000
WIDGET_CHAT_CORS_ORIGIN=*
NEXT_ALLOWED_ORIGINS=elevatetrust.in,www.elevatetrust.in

NEXT_PORT=8001

WIDGET_SESSIONS_DB=/opt/deepfake_et_frontend/HR-Reachout-Agent-main/widget_sessions_store.json
AGENTS_DB=/opt/deepfake_et_frontend/HR-Reachout-Agent-main/Agents_store.json

APP_DIR=/opt/deepfake_et_frontend
GIT_BRANCH=feature/chatops-deploy
GIT_REPO=https://github.com/Pandey-A/ET-Revamped.git

# --- OpenAI (FastAPI / AgentManager; do not commit real keys) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_DEFAULT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
