# =============================================================================
# EC2 public IP (HTTP) — copy to /opt/deepfake_et_frontend/.env
# Or run on server: sudo bash deploy/scripts/configure-ec2-ip-env.sh YOUR_IP
# =============================================================================

DEPLOY_TARGET=ip
EC2_PUBLIC_IP=REPLACE_WITH_YOUR_EC2_IP
APP_DOMAIN=REPLACE_WITH_YOUR_EC2_IP
APP_PUBLIC_URL=http://REPLACE_WITH_YOUR_EC2_IP
COOKIE_SECURE=false

# Telegram needs HTTPS + domain — leave empty until elevatetrust.in (or new domain) is ready
TELEGRAM_WEBHOOK_BASE_URL=

POSTGRES_USER=chattiq
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=chattiq
DATABASE_URL=postgresql://chattiq:CHANGE_ME_STRONG_PASSWORD@127.0.0.1:5432/chattiq

REDIS_URL=redis://127.0.0.1:6379

PORT=8002
NODE_ENV=production
JWT_SECRET=CHANGE_ME_JWT_SECRET_MIN_32_CHARS
EMAIL_VERIFY_SECRET=CHANGE_ME_EMAIL_VERIFY_SECRET
FRONTEND_URL=http://REPLACE_WITH_YOUR_EC2_IP
CORS_ORIGINS=http://REPLACE_WITH_YOUR_EC2_IP
CORS_EXTRA_ORIGINS=
FASTAPI_AGENT_SYNC_URL=http://127.0.0.1:8000
AI_AGENT_API_URL=http://127.0.0.1:8000

NEXT_PUBLIC_API_URL=http://REPLACE_WITH_YOUR_EC2_IP/api
NEXT_PUBLIC_AI_AGENT_API_URL=http://REPLACE_WITH_YOUR_EC2_IP/api/agent
NEXT_PUBLIC_APP_ORIGIN=http://REPLACE_WITH_YOUR_EC2_IP
NEXT_PUBLIC_WIDGET_CHAT_API_URL=http://REPLACE_WITH_YOUR_EC2_IP
WIDGET_CHAT_CORS_ORIGIN=*
NEXT_ALLOWED_ORIGINS=REPLACE_WITH_YOUR_EC2_IP

NEXT_PORT=8001

WIDGET_SESSIONS_DB=/opt/deepfake_et_frontend/HR-Reachout-Agent-main/widget_sessions_store.json
AGENTS_DB=/opt/deepfake_et_frontend/HR-Reachout-Agent-main/Agents_store.json

APP_DIR=/opt/deepfake_et_frontend
GIT_BRANCH=feature/chatops-deploy
GIT_REPO=https://github.com/Pandey-A/ET-Revamped.git
